# Токен от @BotFather. В репозиторий не класть.
BOT_TOKEN=
BOT_USERNAME=YappoLang_Bot

# Куда открывается Mini App и куда RollyPay вернёт человека после оплаты.
WEBAPP_URL=https://your-app.example
PUBLIC_BASE_URL=https://your-api.example

# Telegram id администратора для команды /stats. 0 — команда никому не доступна.
ADMIN_TELEGRAM_ID=0

# Секрет подписи сессий Mini App. Замените на длинную случайную строку.
APP_SECRET=change-me

# sqlite для старта. Для Postgres достаточно поменять URL, модели те же.
DATABASE_URL=sqlite:///./yappo.db

# Локальный вход без Telegram. На бою поставьте false.
DEMO_MODE=true

# Бесплатный день. Premium снимает оба лимита.
FREE_LESSONS_PER_DAY=3
FREE_CHAT_MESSAGES_PER_DAY=5

# OpenAI-совместимый чат. Пустой ключ — учебный собеседник без внешней модели.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Касса RollyPay. ROLLYPAY_TEST=true добавляет "test": true в создание платежа.
ROLLYPAY_API_KEY=
ROLLYPAY_SIGNING_SECRET=
ROLLYPAY_TEST=true
ROLLYPAY_API_URL=https://rollypay.io
PREMIUM_MONTH_RUB=199.00
PREMIUM_YEAR_RUB=1999.00

# Бонус, когда друг заходит, и дни Premium, когда он платит.
REFERRAL_JOIN_XP=50
REFERRAL_PREMIUM_DAYS=7

REMINDER_POLL_SECONDS=30
